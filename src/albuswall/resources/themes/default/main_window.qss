    border: none; border-radius: 16px;
    color: #f2f2f2; font-size: 15px;
    background: rgba(255, 255, 255, 0.12);
}
QPushButton#DetailCloseButton:hover   { background: rgba(255,255,255,0.26); }
QPushButton#DetailCloseButton:pressed { background: rgba(255,255,255,0.36); }
